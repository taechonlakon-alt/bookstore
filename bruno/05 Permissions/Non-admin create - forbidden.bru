meta {
  name: Non-admin create - forbidden
  type: http
  seq: 31
}

post {
  url: {{baseUrl}}/api/v1/books
  body: json
  auth: none
}

headers {
  Cookie: {{userCookie}}
}

body:json {
  {
    "book": {
      "title": "Should not be created",
      "category_id": "{{existingCategoryId}}"
    }
  }
}

tests {
  test("returns 403", function () {
    expect(res.status).to.equal(403);
  });

  test("returns Forbidden", function () {
    expect(res.body.error).to.equal("Forbidden");
  });
}

docs {
  Failure: a normal user cannot create books (admin only), so 403.
}
