meta {
  name: No login - unauthorized
  type: http
  seq: 30
}

get {
  url: {{baseUrl}}/api/v1/books
  body: none
  auth: none
}

tests {
  test("returns 401", function () {
    expect(res.status).to.equal(401);
  });

  test("returns Unauthorized", function () {
    expect(res.body.error).to.equal("Unauthorized");
  });
}

docs {
  Failure: a request without a session cookie gives 401. If this returns 200 in VS Code, turn off automatic cookies in Bruno's settings.
}
