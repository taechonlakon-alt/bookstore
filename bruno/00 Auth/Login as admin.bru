meta {
  name: Login as admin
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/session
  body: formUrlEncoded
  auth: none
}

headers {
  Cookie: {{csrfCookie}}
}

body:form-urlencoded {
  authenticity_token: {{csrfToken}}
  email_address: {{adminEmail}}
  password: {{password}}
}

script:pre-request {
  // Keep the 302 so we can read the session cookie from it.
  req.setMaxRedirects(0);
}

script:post-response {
  // Read a cookie from this response. The CLI exposes the Set-Cookie header,
  // but the VS Code extension hides it, so fall back to Bruno's cookie jar.
  async function readCookie(name) {
    const fromHeader = [].concat(res.getHeader("set-cookie") || [])
      .find((c) => c.startsWith(name + "="));
    if (fromHeader) return fromHeader.split(";")[0];

    const fromJar = await bru.cookies.jar().getCookie(bru.getEnvVar("baseUrl"), name);
    const value = fromJar && typeof fromJar === "object" ? fromJar.value : fromJar;
    return value ? name + "=" + value : "";
  }

  bru.setVar("adminCookie", await readCookie("session_id"));

  // Bruno would otherwise resend stored cookies on every request. Clear its
  // jar so each request only sends the Cookie header it sets itself.
  await bru.cookies.jar().clear();
}

tests {
  test("redirects after login (302)", function () {
    expect(res.status).to.equal(302);
  });

  test("sets a session_id cookie", function () {
    expect(bru.getVar("adminCookie")).to.match(/^session_id=/);
  });
}

docs {
  Logs in as {{adminEmail}} and saves the session cookie in `adminCookie`.
}
