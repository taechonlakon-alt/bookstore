meta {
  name: Create category
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/categories
  body: json
  auth: none
}

headers {
  Cookie: {{adminCookie}}
}

body:json {
  {
    "category": {
      "name": "Bruno Category {{runId}}"
    }
  }
}

script:post-response {
  bru.setVar("categoryId", res.body.id);
}

tests {
  test("returns 201", function () {
    expect(res.status).to.equal(201);
  });

  test("returns the new category", function () {
    expect(res.body.name).to.equal("Bruno Category " + bru.getVar("runId"));
  });
}

docs {
  Success: an admin creates a category. Saves its id in `categoryId`.
}
