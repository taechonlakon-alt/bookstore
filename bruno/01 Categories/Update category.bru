meta {
  name: Update category
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/v1/categories/{{categoryId}}
  body: json
  auth: none
}

headers {
  Cookie: {{adminCookie}}
}

body:json {
  {
    "category": {
      "name": "Bruno Category {{runId}} (edited)"
    }
  }
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });

  test("returns the updated values", function () {
    expect(res.body.name).to.match(/\(edited\)$/);
  });
}

docs {
  Success: an admin updates the category.
}
