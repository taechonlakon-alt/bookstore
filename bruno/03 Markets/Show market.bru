meta {
  name: Show market
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/api/v1/markets/{{marketId}}
  body: none
  auth: none
}

headers {
  Cookie: {{adminCookie}}
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });

  test("returns the market that was created", function () {
    expect(res.body.id).to.equal(bru.getVar("marketId"));
  });
}

docs {
  Success: shows the market created earlier in this run.
}
