meta {
  name: Update market
  type: http
  seq: 23
}

patch {
  url: {{baseUrl}}/api/v1/markets/{{marketId}}
  body: json
  auth: none
}

headers {
  Cookie: {{adminCookie}}
}

body:json {
  {
    "market": {
      "name": "Bruno Market {{runId}} (edited)"
    }
  }
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });

  test("returns the updated values", function () {
    expect(res.body.name).to.match(/\(edited\)$/);
  });
}

docs {
  Success: an admin updates the market.
}
