meta {
  name: Create market
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/v1/markets
  body: json
  auth: none
}

headers {
  Cookie: {{adminCookie}}
}

body:json {
  {
    "market": {
      "name": "Bruno Market {{runId}}",
      "book_ids": [
        "{{existingBookId}}"
      ]
    }
  }
}

script:post-response {
  bru.setVar("marketId", res.body.id);
}

tests {
  test("returns 201", function () {
    expect(res.status).to.equal(201);
  });

  test("returns the new market", function () {
    expect(res.body.name).to.equal("Bruno Market " + bru.getVar("runId"));
    expect(res.body.books.map((b) => b.id)).to.include(Number(bru.getVar("existingBookId")));
  });
}

docs {
  Success: an admin creates a market. Saves its id in `marketId`.
}
