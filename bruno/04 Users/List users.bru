meta {
  name: List users
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/api/v1/users
  body: none
  auth: none
}

headers {
  Cookie: {{adminCookie}}
}

script:post-response {
  // Remember the logged-in admin's id for the "delete yourself" case.
  const admin = res.body.find((u) => u.email_address === bru.getEnvVar("adminEmail"));
  bru.setVar("adminId", admin ? admin.id : "");
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });

  test("never exposes password hashes", function () {
    res.body.forEach((u) => expect(u).to.not.have.property('password_digest'));
  });
}

docs {
  Success: an admin lists users. Password hashes must not appear in the response.
}
