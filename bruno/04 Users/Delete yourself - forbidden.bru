meta {
  name: Delete yourself - forbidden
  type: http
  seq: 28
}

delete {
  url: {{baseUrl}}/api/v1/users/{{adminId}}
  body: none
  auth: none
}

headers {
  Cookie: {{adminCookie}}
}

tests {
  test("returns 422", function () {
    expect(res.status).to.equal(422);
  });

  test("explains why", function () {
    expect(res.body.errors).to.include("You cannot delete your own account");
  });
}

docs {
  Failure: an admin cannot delete their own account.
}
