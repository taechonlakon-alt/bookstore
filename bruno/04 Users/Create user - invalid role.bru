meta {
  name: Create user - invalid role
  type: http
  seq: 27
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: none
}

headers {
  Cookie: {{adminCookie}}
}

body:json {
  {
    "user": {
      "email_address": "bruno-bad-{{runId}}@example.com",
      "password": "password",
      "role": "superuser"
    }
  }
}

tests {
  test("returns 422", function () {
    expect(res.status).to.equal(422);
  });

  test("says the role is invalid", function () {
    expect(res.body.errors.join(" ")).to.match(/Role/);
  });
}

docs {
  Failure: a role other than `user` or `admin` gives 422.
}
