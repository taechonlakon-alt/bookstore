meta {
  name: Create user
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: none
}

headers {
  Cookie: {{adminCookie}}
}

body:json {
  {
    "user": {
      "email_address": "bruno-{{runId}}@example.com",
      "password": "password",
      "password_confirmation": "password",
      "role": "user"
    }
  }
}

script:post-response {
  bru.setVar("userId", res.body.id);
}

tests {
  test("returns 201", function () {
    expect(res.status).to.equal(201);
  });

  test("returns the new user", function () {
    expect(res.body.email_address).to.equal("bruno-" + bru.getVar("runId") + "@example.com");
    expect(res.body.role).to.equal("user");
  });
}

docs {
  Success: an admin creates a user. Saves its id in `userId`.
}
