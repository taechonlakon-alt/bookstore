meta {
  name: Delete user
  type: http
  seq: 29
}

delete {
  url: {{baseUrl}}/api/v1/users/{{userId}}
  body: none
  auth: none
}

headers {
  Cookie: {{adminCookie}}
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });

  test("confirms the delete", function () {
    expect(res.body.message).to.equal("User deleted");
  });
}

docs {
  Success: an admin deletes the user created above.
}
