meta {
  name: Update book
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/api/v1/books/{{bookId}}
  body: json
  auth: none
}

headers {
  Cookie: {{adminCookie}}
}

body:json {
  {
    "book": {
      "title": "Bruno Book {{runId}} (edited)"
    }
  }
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });

  test("returns the updated values", function () {
    expect(res.body.title).to.match(/\(edited\)$/);
  });
}

docs {
  Success: an admin updates the book.
}
