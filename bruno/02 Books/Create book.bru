meta {
  name: Create book
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/books
  body: json
  auth: none
}

headers {
  Cookie: {{adminCookie}}
}

body:json {
  {
    "book": {
      "title": "Bruno Book {{runId}}",
      "author": "Bruno",
      "description": "Created by the Bruno tests",
      "category_id": "{{existingCategoryId}}"
    }
  }
}

script:post-response {
  bru.setVar("bookId", res.body.id);
}

tests {
  test("returns 201", function () {
    expect(res.status).to.equal(201);
  });

  test("returns the new book", function () {
    expect(res.body.title).to.equal("Bruno Book " + bru.getVar("runId"));
    expect(res.body.category.id).to.equal(Number(bru.getVar("existingCategoryId")));
  });
}

docs {
  Success: an admin creates a book. Saves its id in `bookId`.
}
