<div class="mt-4 space-y-1 text-sm text-gray-500">
  <% if controller_name != "sessions" %>
    <p><%= link_to "Sign in", new_session_path(resource_name), class: "text-gray-700 underline hover:no-underline" %></p>
  <% end %>

  <% if devise_mapping.registerable? && controller_name != "registrations" %>
    <p><%= link_to "Sign up", new_registration_path(resource_name), class: "text-gray-700 underline hover:no-underline" %></p>
  <% end %>

  <% if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
    <p><%= link_to "Forgot password?", new_password_path(resource_name), class: "text-gray-700 underline hover:no-underline" %></p>
  <% end %>
</div>
