<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Forgot your password?</h1>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "contents" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="my-5">
      <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", placeholder: "Enter your email address", class: "block w-full mt-2 border border-gray-300 rounded px-3 py-2" %>
    </div>

    <%= f.submit "Email reset instructions", class: "px-4 py-2 bg-gray-800 text-white rounded cursor-pointer" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
