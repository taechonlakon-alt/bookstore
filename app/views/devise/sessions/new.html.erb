<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Sign in</h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "contents" }) do |f| %>
    <div class="my-5">
      <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", placeholder: "Enter your email address", class: "block w-full mt-2 border border-gray-300 rounded px-3 py-2" %>
    </div>

    <div class="my-5">
      <%= f.password_field :password, required: true, autocomplete: "current-password", placeholder: "Enter your password", maxlength: 128, class: "block w-full mt-2 border border-gray-300 rounded px-3 py-2" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="my-5">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me, class: "text-sm text-gray-700" %>
      </div>
    <% end %>

    <%= f.submit "Sign in", class: "px-4 py-2 bg-gray-800 text-white rounded cursor-pointer" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
