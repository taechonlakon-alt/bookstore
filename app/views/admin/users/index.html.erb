<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-bold">Manage users</h1>
  <%= link_to "New user", new_admin_user_path, class: "px-4 py-2 bg-gray-800 text-white rounded" %>
</div>

<table class="w-full text-left border-collapse">
  <thead>
    <tr class="border-b border-gray-300">
      <th class="py-2">Email</th>
      <th class="py-2">Role</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr class="border-b border-gray-200">
        <td class="py-2"><%= user.email_address %></td>
        <td class="py-2 text-gray-600"><%= user.role %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p class="mt-6"><%= link_to "← Back to admin", admin_root_path, class: "hover:underline" %></p>
