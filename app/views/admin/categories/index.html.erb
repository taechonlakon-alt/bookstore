<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-bold">Manage categories</h1>
  <%= link_to "New category", new_admin_category_path, class: "px-4 py-2 bg-gray-800 text-white rounded" %>
</div>

<table class="w-full text-left border-collapse">
  <thead>
    <tr class="border-b border-gray-300">
      <th class="py-2">Name</th>
      <th class="py-2">Books</th>
      <th class="py-2"></th>
    </tr>
  </thead>
  <tbody>
    <% @categories.each do |category| %>
      <tr class="border-b border-gray-200">
        <td class="py-2"><%= category.name %></td>
        <td class="py-2 text-gray-600"><%= category.books_count %></td>
        <td class="py-2 text-right whitespace-nowrap">
          <%= link_to "Edit", edit_admin_category_path(category), class: "hover:underline mr-3" %>
          <%= button_to "Delete", admin_category_path(category), method: :delete,
                form: { class: "inline", data: { turbo_confirm: "Are you sure?" } },
                class: "text-red-700 hover:underline cursor-pointer" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<p class="mt-6"><%= link_to "← Back to admin", admin_root_path, class: "hover:underline" %></p>
